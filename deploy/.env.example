# Copy this file to deploy/.env and change every value marked CHANGE_ME before deployment.

# Docker image name. For local builds, gf3-web:local is enough.
# For registry-based deploys, use something like ghcr.io/YOUR_ACCOUNT/gf3:latest.
GF3_IMAGE=gf3-web:local

# Public host name handled by nginx. Use "_" for local HTTP tests.
GF3_SERVER_NAME=_
GF3_HTTP_PORT=80
GF3_HTTPS_PORT=443

# Persistent Docker volume name for SQLite database + built-in backups.
GF3_DATA_VOLUME=gf3-data

# Existing production updates must keep this true. Set false only for the very first empty install.
GF3_REQUIRE_EXISTING_DATABASE=true
GF3_BACKUP_BEFORE_MIGRATE=true

# Required production secret. Generate a long random value, do not commit deploy/.env.
Jwt__SigningKey=CHANGE_ME_generate_64_plus_random_bytes

# Optional password recovery SMTP settings.
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__UserName=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromDisplayName=GF3

# Keep database maintenance endpoints closed on a public server.
GF3_ADMIN_ENABLED=false
GF3_ADMIN_ALLOW_REMOTE=false
GF3_ADMIN_ALLOW_WRITE=false

# Only needed when using deploy/docker-compose.https.yml.
GF3_TLS_CERT_PATH=./certs/fullchain.pem
GF3_TLS_KEY_PATH=./certs/privkey.pem

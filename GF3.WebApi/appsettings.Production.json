{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AdminTools": {
    "Enabled": false,
    "AllowRemoteAccess": false,
    "AllowWriteSql": false,
    "MaxSqlLength": 20000,
    "MaxImportBytes": 2000000
  },
